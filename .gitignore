# Internal working notes: never in a public repo
PROGRESS.md
CLAUDE.md
AGENTS.md
DEFERRED.md
.claude/

# The guard itself carries the forbidden list; it lives in .git/hooks only
scripts/publish-guard.py

# Recording profile: holds a signed-in session, never commit
.shoot-profile/

# Recording output: screenshots, takes and the cut (large, regenerated)
docs/recording/
# Synthesised speech, one folder per cut. Rebuilt from the cut's
# <cut>.narration.txt by scripts/make-narration.sh, so it is not committed.
docs/narration/
docs/narration-*/

# Values this repository has told publish-guard are public chain data.
.publish-allow

# Built from a cut's script and its narration, not committed.
docs/demo.narration.wav
docs/bounty.narration.wav
